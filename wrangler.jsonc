// Site en ligne sur Cloudflare Pages (https://aide-build-poe2.pages.dev).
// Projet Pages dans le tableau de bord : Build command = npm run build:web (le reste vient de ce fichier).
// Les fonctions du dossier functions/ transmettent /mcp et /relais au Worker « aide-build-poe2-claude »
// (configuration : cloudflare/wrangler.jsonc) par la liaison de service OUTILS.
{
  "name": "aide-build-poe2",
  "pages_build_output_dir": "./web/dist-web",
  "compatibility_date": "2026-09-01",
  "services": [{ "binding": "OUTILS", "service": "aide-build-poe2-claude" }]
}
